<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only for the simulator test: the keychain (the https certificate's key). The real app's entitlements are in
	     WalkieTales.entitlements; the simulator won't launch an app signed with the phone-only ones (NFC, app id). -->
	<key>keychain-access-groups</key>
	<array>
		<string>app.cardplayer.ios</string>
	</array>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>application-identifier</key>
	<string>app.cardplayer.ios</string>
	<!-- The keychain keeps the key for the player's own https certificate (voice messages need a secure address). -->
	<key>keychain-access-groups</key>
	<array>
		<string>app.cardplayer.ios</string>
	</array>
	<key>get-task-allow</key>
	<false/>
	<!-- Core NFC tag reading (iPhone 7 and later). TrollStore honours these entitlements without a paid developer account. -->
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
</dict>
</plist>
